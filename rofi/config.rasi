configuration {
	modi: "drun";
	icon-theme: "Papirus-Dark";
	show-icons: true;
}

/* ==========================================================================
   Graphite-Red-Dark Theme for Rofi
   Based on vinceliuice/Graphite-gtk-theme (graphite-red-dark variant)
   ========================================================================== */

* {
	/* --- Graphite Dark Backgrounds --- */
	bg0:         #1c1c1c;   /* deepest background (window/overlay) */
	bg1:         #242424;   /* main surface */
	bg2:         #2c2c2c;   /* slightly elevated surface */
	bg3:         #383838;   /* header / input bar */
	bg4:         #444444;   /* separator / border */

	/* --- Foreground / Text --- */
	fg0:         #dedede;   /* primary text */
	fg1:         #c0c0c0;   /* secondary text / placeholders */
	fg2:         #888888;   /* dimmed / comment */

	/* --- Red Accent (Graphite-red) --- */
	accent:      #e05c5c;   /* primary accent */
	accent-alt:  #c0392b;   /* darker accent for pressed states */
	accent-dim:  #5a2020;   /* muted accent for subtle highlights */

	/* --- Semantic aliases --- */
	background-color:   @bg0;
	border-color:       @bg4;
	text-color:         @fg0;

	font:        "Sans 11";
	cursor:      "default";
}

/* ── Window ───────────────────────────────────────────────── */
window {
	background-color: @bg1;
	border:           2px solid;
	border-color:     @bg4;
	border-radius:    12px;
	width:            640px;
	padding:          0px;
}

/* ── Main layout ──────────────────────────────────────────── */
mainbox {
	background-color: transparent;
	padding:          0px;
	spacing:          0px;
}

/* ── Input bar ────────────────────────────────────────────── */
inputbar {
	background-color: @bg3;
	border-radius:    12px 12px 0px 0px;
	padding:          12px 16px;
	spacing:          8px;
	children:         [ prompt, entry ];
}

prompt {
	background-color: transparent;
	text-color:       @accent;
	font:             "Sans Bold 11";
}

entry {
	background-color: transparent;
	text-color:       @fg0;
	placeholder:      "Search…";
	placeholder-color: @fg2;
}

/* ── Separator ────────────────────────────────────────────── */
separator {
	background-color: @bg4;
	height:           1px;
	margin:           0px;
}

/* ── List view ────────────────────────────────────────────── */
listview {
	background-color: transparent;
	padding:          8px;
	spacing:          2px;
	lines:            8;
	columns:          1;
	fixed-height:     true;
	scrollbar:        true;
}

/* ── Scrollbar ────────────────────────────────────────────── */
scrollbar {
	background-color: @bg2;
	handle-color:     @bg4;
	handle-width:     4px;
	border-radius:    2px;
	width:            6px;
	margin:           4px 2px;
}

/* ── List elements ────────────────────────────────────────── */
element {
	background-color: transparent;
	border-radius:    8px;
	padding:          8px 12px;
	spacing:          10px;
	orientation:      horizontal;
	children:         [ element-icon, element-text ];
}

element normal.normal,
element alternate.normal {
	background-color: transparent;
	text-color:       @fg0;
}

element selected.normal {
	background-color: @accent-dim;
	text-color:       @fg0;
	border:           1px solid;
	border-color:     @accent;
}

element normal.urgent,
element alternate.urgent {
	text-color:       @accent;
}

element selected.urgent {
	background-color: @accent-alt;
	text-color:       @fg0;
}

element normal.active,
element alternate.active {
	text-color:       @accent;
}

element selected.active {
	background-color: @accent-dim;
	text-color:       @accent;
}

element-icon {
	background-color: transparent;
	size:             24px;
}

element-text {
	background-color: transparent;
	text-color:       inherit;
	highlight:        bold #e05c5c;
	vertical-align:   0.5;
}

/* ── Message / error ──────────────────────────────────────── */
message {
	background-color: @bg2;
	border-radius:    0px 0px 12px 12px;
	padding:          8px 16px;
}

textbox {
	background-color: transparent;
	text-color:       @fg1;
}
